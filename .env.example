# ============================================================
# ITADAKIMASU  Plantilla de variables de entorno (SIN secretos)
# Copia este archivo como .env.local y rellena los valores.
# En producción (Vercel) configura estas mismas variables
# en Project Settings -> Environment Variables.
# ============================================================

# ---------- Modo de datos ----------
# local -> catálogo y operaciones en almacenamiento local (demo, sin servicios externos)
# neon  -> PostgreSQL en Neon (requiere NEON_DATABASE_URL)
DATA_PROVIDER=local

# ---------- Modo de autenticación ----------
# local    -> scrypt + cookie firmada HMAC (demo / desarrollo)
# supabase -> Supabase Auth con cookies @supabase/ssr (producción)
AUTH_MODE=local

# ---------- Neon (requerido cuando DATA_PROVIDER=neon) ----------
# Neon pooled connection para la app: rol itadakimasu_runtime (NOBYPASSRLS).
# La URL del propietario se reserva para migraciones y no se usa en Vercel.
NEON_DATABASE_URL=

# ---------- Supabase (Auth e imágenes de producto) ----------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. NUNCA exponer en el cliente ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional; el bucket público se crea al subir la primera imagen.
SUPABASE_STORAGE_BUCKET=producto-imagenes

# ---------- Sesión ----------
# Secreto para firmar cookies de sesión en modo local.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- URL pública ----------
# En Vercel: https://tu-dominio.vercel.app (usada por Supabase Auth
# para los enlaces de confirmación y recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Generación de anuncios (opcional en desarrollo local) ----------
# En Vercel, AI Gateway usa la autenticación OIDC del proyecto automáticamente.
# Para desarrollo local, configura una clave de AI Gateway o usa `vercel dev`.
AI_GATEWAY_API_KEY=

# ---------- Correos transaccionales (Resend, opcional; solo modo local) ----------
RESEND_API_KEY=
EMAIL_FROM="ITADAKIMASU <no-reply@itadakimasu.pe>"

# ---------- Pasarela de pagos online (opcional, FASE 6) ----------
# Configura el proveedor disponible en Perú y su webhook secreto.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------- Cuenta admin inicial (semilla, modo local) ----------
ADMIN_EMAIL=admin@itadakimasu.pe
ADMIN_PASSWORD=
